# Lab3: Sandbox (test) environment. Copy to config/.env.sandbox.
# Loaded automatically when APP_ENV=sandbox, layered over config/.env.

APP_ENV=sandbox
DEBUG=true
LOG_LEVEL=DEBUG

# Isolated sandbox database - test data never reaches production.
DATABASE_URL=postgresql+asyncpg://cyberimplant:cyberimplant@localhost:5433/cyberimplant_sandbox

SECRET_KEY=sandbox-insecure-secret-change-me-0123456789

# Enabled so the Lab 3 demo can trigger a 500 and show the detailed error body.
ENABLE_DEMO_ERROR_ROUTE=true
