# Copy to .env and adjust for your environment. Never commit the real .env.

# Async SQLAlchemy connection string (asyncpg driver).
# Used by both the FastAPI app and Alembic migrations (async engine end-to-end).
# Port 5433, not 5432 — see docker-compose.yml comment.
DATABASE_URL=postgresql+asyncpg://cyberimplant:cyberimplant@localhost:5433/cyberimplant

APP_ENV=development
LOG_LEVEL=INFO
