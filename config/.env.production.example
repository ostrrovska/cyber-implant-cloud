# Lab3: Production environment. Copy to config/.env.production and set real secrets.
# Loaded automatically when APP_ENV=production, layered over config/.env.

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Isolated production database, separate from sandbox.
DATABASE_URL=postgresql+asyncpg://cyberimplant:cyberimplant@localhost:5433/cyberimplant_prod

# Use a real 32+ byte random secret in a true deployment (e.g. `openssl rand -hex 32`).
SECRET_KEY=CHANGE-ME-use-a-32-byte-random-secret-in-production

# For the Lab 3 demo only, so a 500 can be triggered to show the stacktrace is hidden.
# In a real deployment leave this off (false).
ENABLE_DEMO_ERROR_ROUTE=true
